{#- Right sidebar, navigation only. A Card page lists the Cards around it:
    its parent, its replies, and the Cards that link to it. -#}
<aside class="sidebar">
  {%- if card %}
  {%- if card.parent %}
  <nav class="side-block">
    <h2>In reply to</h2>
    <ul>{% set s = card.parent %}{% include "side-item.njk" %}</ul>
  </nav>
  {%- endif %}
  <nav class="side-block">
    <h2>Replies</h2>
    {%- if card.replies.length %}
    <ul>{% for s in card.replies %}{% include "side-item.njk" %}{% endfor %}</ul>
    {%- else %}
    <p class="side-empty">none yet</p>
    {%- endif %}
  </nav>
  <nav class="side-block">
    <h2>Linked from</h2>
    {%- if card.linkedFrom.length %}
    <ul>{% for s in card.linkedFrom %}{% include "side-item.njk" %}{% endfor %}</ul>
    {%- else %}
    <p class="side-empty">none yet</p>
    {%- endif %}
  </nav>
  {%- else %}
  <nav class="side-block">
    <h2>Recent</h2>
    <ul>{% for s in cards | reverse %}{% if loop.index <= 7 %}{% include "side-item.njk" %}{% endif %}{% endfor %}</ul>
    <p class="side-more"><a href="/all/">All Cards →</a></p>
  </nav>
  {%- endif %}
  <nav class="side-block">
    <h2>On Bluesky</h2>
    <ul>
      {%- for a in site.authors %}
      <li><a href="{{ a.bluesky }}">@{{ a.handle }}</a> <span class="side-note">{{ a.role }}</span></li>
      {%- endfor %}
    </ul>
  </nav>
</aside>
